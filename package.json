{
  "name": "masf-smoke-test",
  "version": "0.1.0",
  "private": true,
  "description": "Plantilla de gobernanza de Mindscope Analytics: reglas para Claude Code, compuertas locales, CI y presets.",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare": "bash scripts/setup-hooks.sh",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci && pnpm run test:guard",
    "test:guard": "bash scripts/test-guard.sh",
    "lint:workflows": "actionlint",
    "check:rls": "bash scripts/check-rls.sh",
    "check:secrets": "gitleaks git --redact --no-banner .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:watch": "jest --watch",
    "export:web": "expo export -p web && printf '/* /index.html 200\\n' > dist/_redirects",
    "e2e:web": "playwright test",
    "e2e:mobile": "maestro test .maestro/",
    "deploy:web": "npx -y wrangler@4 pages deploy dist --project-name ${CF_PAGES_PROJECT:-app}"
  },
  "main": "expo-router/entry",
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.test.tsx"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "~4.7.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jest": "~29.5.14",
    "@types/node": "^22.18.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.15",
    "serve": "^14.2.0",
    "typescript": "~5.9.2"
  }
}
